# ─────────────────────────────────────────────────────────────────────────────
# Evolution Managed Identities — параметры OIDC public client (Authorization Code + PKCE)
#
# Эти переменные используются ТОЛЬКО при локальном запуске `npm run dev`
# (Vite читает переменные с префиксом VITE_).
#
# В Docker-образе те же значения передаются БЕЗ префикса VITE_
# (OIDC_AUTHORITY, OIDC_CLIENT_ID, ...) и подставляются при старте контейнера.
# Подробнее — в README.md.
# ─────────────────────────────────────────────────────────────────────────────

# Issuer / база для OIDC discovery (без /.well-known/openid-configuration).
VITE_OIDC_AUTHORITY=https://<your-evolution-mi-issuer>

# client_id публичного клиента, заведённого в Evolution Managed Identities.
VITE_OIDC_CLIENT_ID=<your-public-client-id>

# Необязательно. По умолчанию: window.location.origin + /callback
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback

# Необязательно. По умолчанию: window.location.origin + /
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# Необязательно. По умолчанию: "openid profile"
VITE_OIDC_SCOPE=openid profile

# Необязательно. Путь (через точку) до клейма с ролями. Поддерживается
# шаблонизация %%ИМЯ%% — подставляются значения конфиг-переменных по их env-имени:
# %%OIDC_CLIENT_ID%%, %%OIDC_AUTHORITY%%, %%OIDC_SCOPE%%, %%OIDC_ROLES_CLAIM%%.
# По умолчанию (Keycloak-подобный токен): resource_access.%%OIDC_CLIENT_ID%%.roles
VITE_OIDC_ROLES_CLAIM_PATH=resource_access.%%OIDC_CLIENT_ID%%.roles

# Необязательно. Имя плоского клейма с ролями — используется как доп. фолбэк,
# если ничего не нашлось по пути выше. По умолчанию: "roles"
VITE_OIDC_ROLES_CLAIM=roles

# ─── CORS-фикс ───────────────────────────────────────────────────────────────
# Необязательно. true → OIDC back-channel (token/jwks/userinfo) идёт через
# same-origin reverse proxy /oidc/ в контейнере, и CORS в браузере не нужен.
# По умолчанию: false. В dev (Vite) прокси нет — см. README про vite proxy.
VITE_OIDC_PROXY=false

# Необязательно. true → после логина запрашивается userinfo (доп. cross-origin
# XHR). По умолчанию: false (роли и имя берём из токенов).
VITE_OIDC_LOAD_USERINFO=false

# ─── Confidential client (demo-only) ─────────────────────────────────────────
# Необязательно. Если задан — приложение работает как confidential client и
# отправляет client_secret при обмене кода на токены.
# ВНИМАНИЕ: в SPA секрет виден в браузере — только для демо/проверки IdP.
VITE_OIDC_CLIENT_SECRET=
